# =============================================================================
# Grimoire Bivouak — Caddy interne du conteneur (HTTP :80).
# Le TLS est géré par le proxy partagé (amui-proxy), pas ici.
#
# Sert le site statique (app/index.html + versions). L'app parle directement à
# Supabase depuis le navigateur : aucun backend à proxifier.
# =============================================================================

{
	# Pas de HTTPS interne : le proxy amont s'en charge.
	auto_https off
}

:80 {
	encode zstd gzip
	root * /srv

	# L'ordre compte, et le deuxième essai est indispensable :
	#   /                → /srv/index.html          (la vitrine)
	#   /app/            → /srv/app/index.html      (l'application)
	#   /img/x.png       → le fichier
	#   n'importe quoi   → la vitrine
	# Sans « {path}/index.html », une adresse en dossier comme /app/ ne
	# correspond à aucun fichier et tombe sur le repli : l'application
	# renvoyait la page d'accueil.
	try_files {path} {path}/index.html /index.html
	file_server
}
